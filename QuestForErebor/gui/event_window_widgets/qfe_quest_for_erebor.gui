vbox = {
	name = "qfe_quest_for_erebor"
	layoutpolicy_horizontal = expanding
	margin = { 10 0 }

	datacontext = "[EventWindowWidget.GetScope.sC('scope_character')]"

	divider_light = {
		layoutpolicy_horizontal = expanding
	}

	hbox = {
		layoutpolicy_horizontal = expanding
		icon = {
			name = "quest_icon"
			size = { 50 50 }
			framesize = { 80 80 }
			texture = "gfx/interface/icons/widgets/QFE_quest.dds"
			tooltip = "event_window_widget_quest_tooltip_widget"
		}

		text_single = {
			name = "quest_text"
			text = event_window_widget_quest
			layoutpolicy_horizontal = expanding
			autoresize = no
		}
	}
}

